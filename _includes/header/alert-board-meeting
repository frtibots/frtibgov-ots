{% comment -%}
Board Meeting Alert
===================

EDIT ONLY THE SETTINGS SECTION BELOW.

showAlert:
  true  = show the Board Meeting alert
  false = hide the alert

showETAC:
  true  = Board and ETAC joint meeting
  false = Board meeting only

Update the meeting date, time, phone number,
conference ID, dial-in number, and Teams URL
for each meeting.

DO NOT CHANGE THE CODE BELOW THE SETTINGS SECTION.
{% endcomment -%}


{% comment -%}
==================================================
SETTINGS - EDIT THESE VALUES ONLY
==================================================
{% endcomment -%}

{% assign showAlert = true -%}
{% assign showETAC = false -%}

{% assign confDate = "Tuesday, October 27" -%}
{% assign confTime = "9:00 a.m. ET" -%}

{% assign confPhone = "1-202-599-1426" -%}
{% assign confID = "192 871 229#" -%}

{% assign confDialNumber = "+12025991426" -%}
{% assign confDialID = "605436724#" -%}

{% capture confURL -%}
https://teams.microsoft.com/dl/launcher/launcher.html?url=%2F_%23%2Fl%2Fmeetup-join%2F19%3Ameeting_OTlkZTg4YWYtNDgyZS00ZmU2LTk0MmItNGZmOTAxZDcwYjNh%40thread.v2%2F0%3Fcontext%3D%257b%2522Tid%2522%253a%25223f6323b7-e3fd-4f35-b43d-1a7afae5910d%2522%252c%2522Oid%2522%253a%25221a441fb8-5318-4ad0-995b-f28a737f4128%2522%257d%26anon%3Dtrue&type=meetup-join&deeplinkId=bdd060ca-ef72-416a-bd12-0441c7403ae6&directDl=true&msLaunch=true&enableMobilePage=true&suppressPrompt=true
{% endcapture -%}


{% comment -%}
==================================================
DO NOT CHANGE ANYTHING BELOW THIS LINE
==================================================
{% endcomment -%}


{% if showAlert %}

  {% if showETAC %}
    {% assign ETAC = "and the Employee Thrift Advisory Council (ETAC)" -%}
  {% else %}
    {% assign ETAC = "" -%}
  {% endif %}


  {% assign alertHeader = include.alertHeader
    | default: "Board Meeting "
    | append: confTime
    | append: " "
    | append: confDate
  -%}


  {% assign alertIcon = "icon_redImportant.gif" -%}


  {% capture alertTitle -%}
    <img
      src="{{ site.baseurl }}/assets/img/{{ alertIcon }}"
      class="usa-banner__header-flag"
      alt=""
    />
    {{ alertHeader }}
  {% endcapture -%}


  <a
    id="alert-message-button"
    href="#header-alert-modal"
    class="usa-button alert-button"
    aria-controls="header-alert-modal"
    data-open-modal>
    {{ alertTitle }}
  </a>


  <div
    class="usa-modal"
    id="header-alert-modal"
    aria-labelledby="alert-modal-heading"
    aria-describedby="alert-modal-description">

    <div class="usa-modal__content">

      <div class="usa-modal__main">

        <h2
          class="usa-modal__heading"
          id="alert-modal-heading">
          {{ alertHeader }}
        </h2>

        <div
          class="usa-prose break-word"
          id="alert-modal-description">

          <p>
            The Board {{ ETAC }} will be meeting at
            {{ confTime }} on {{ confDate }}.
          </p>

          <p>
            Members of the public will not be allowed inside the building.
          </p>

          <p>
            Members of the public who are interested have two options
            to listen to the Board meeting:
          </p>


          <ol>

            <li>
              <strong>By phone</strong><br>
              {{ confPhone }}<br>
              Conference ID: {{ confID }}<br>

              One-touch Dial:
              <a href="tel:{{ confDialNumber }},{{ confDialID }}">
                {{ confPhone }},{{ confDialID }}
              </a>
            </li>


            <li>
              <strong>By browser</strong><br><br>

              <a
                href="{{ confURL | strip }}"
                class="usa-button thin on-card"
                target="_blank"
                rel="noopener">
                Join Board Meeting
              </a>

              <p>
                Select "Continue on this browser" after opening the link.
              </p>
            </li>

          </ol>


          <p>
            Attendees using the Teams link will be able to listen
            to the meeting and view the materials being discussed.
            Their lines will be muted.
          </p>

        </div>

      </div>


      <button
        class="usa-button usa-modal__close on-card"
        aria-label="Close this window"
        data-close-modal>

        <svg
          class="usa-icon"
          aria-hidden="true"
          focusable="false"
          role="img">

          <use xlink:href="../img/usa-icons/close.svg"></use>

        </svg>

      </button>

    </div>

  </div>

{% endif %}
